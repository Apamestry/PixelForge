# PixelForge Environment Configuration Example

# Environment mode: local | gcp
ENV=local
PORT=8080

# Database
DATABASE_URL=postgresql://pixelforge:localdevpassword@localhost:5432/pixelforge

# Auth
JWT_SECRET=dev-secret-key-pixelforge-32-chars-min
JWT_EXPIRE_MINUTES=1440

# Storage: local | gcs
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data
SIGNED_URL_TTL_SECONDS=900
GCS_BUCKET=
SIGNING_SERVICE_ACCOUNT=

# Queue: local | pubsub
QUEUE_BACKEND=local
WORKER_URL=http://localhost:8001
PUBSUB_TOPIC=

# Service URLs
CORE_API_URL=http://localhost:8000
FONT_SERVICE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:3000

# Extensions (Phase 2)
TOOL_AUTH=none
BGREMOVAL_URL=http://localhost:8003
COLOR_URL=http://localhost:8004
